{
  "name": "video-cleaner",
  "version": "1.0.0",
  "description": "VideoCleaner - AI自动视频去水印工具",
  "main": "server_fast.js",
  "scripts": {
    "start": "node server_fast.js",
    "dev": "nodemon server_fast.js",
    "postinstall": "node -e \"if(process.env.PUPPETEER_SKIP_CHROMIUM_DOWNLOAD){console.log('Skipping Chrome download');process.exit(0)}try{require('child_process').execSync('npx puppeteer browsers install chrome',{stdio:'inherit'})}catch(e){process.exit(0)}\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "puppeteer": "^21.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
